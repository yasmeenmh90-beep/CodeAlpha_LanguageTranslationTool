# --- Engine selection --------------------------------------------------------
# Leave empty (recommended) to use the fallback chain:
#   microsoft (if key) -> google (if key) -> mymemory (free) -> free (Google web)
# Or set one of: microsoft | google | mymemory | free  to use ONLY that engine
# by default (no fallback). The UI's engine menu can still override this per request.
TRANSLATOR_PROVIDER=

# --- Microsoft Translator (Azure AI Translator) — free tier: 2M chars/month --
AZURE_TRANSLATOR_KEY=
# The resource's "Location/Region" (e.g. uaenorth, westeurope). Use "global" for global resources.
AZURE_TRANSLATOR_REGION=global

# --- Google Cloud Translation API (v2) ----------------------------------------
GOOGLE_API_KEY=

# --- MyMemory (free, no key) --------------------------------------------------
# Optional: a valid email raises MyMemory's anonymous daily quota (~5,000 -> ~50,000 chars/day).
MYMEMORY_EMAIL=

# --- Tuning -------------------------------------------------------------------
# Number of translations kept in the in-memory LRU cache (0 disables caching).
CACHE_SIZE=500
# Seconds to wait for a translation provider before giving up (per attempt).
REQUEST_TIMEOUT=15
